#include <Adafruit_DHT.h>

// DHT parameters
#define DHTPIN 5
#define DHTTYPE DHT22

// Variables
int SLEEPLED = D7;  //Use the builtin LED on pin 7 to determine when it is awake and asleep. off = asleep, on = awake
int REDled = D1;
int GREENled = D2;
int BLUEled = D3;
int LEDpower = D0; //this pin will power the LED

float temperature;
float humidity;
float brightness = 40;  // this is how bright you want the LED.  0 is off, 255 is full brightness.  You can change this

uint16_t pm10 = 0;
uint16_t pm25 = 0;
uint16_t pm100 = 0;
long filter = 0;
String colour = "unknown";

uint8_t wake[] = { 0x42, 0x4D, 0xE4, 0x00, 0x01, 0x01, 0x74 };
uint8_t sleep[] = { 0x42, 0x4D, 0xE4, 0x00, 0x00, 0x01, 0x73 };

DHT dht(DHTPIN, DHTTYPE);

bool readPms5003Frame(uint16_t &outPm10, uint16_t &outPm25, uint16_t &outPm100) {
  const int FRAME_LEN = 32;
  uint8_t frame[FRAME_LEN];

  // Try to align to header bytes 0x42 0x4D
  unsigned long start = millis();
  while (millis() - start < 3000) {
    if (Serial1.available() >= 2) {
      int b0 = Serial1.read();
      if (b0 != 0x42) {
        continue;
      }

      int b1 = Serial1.read();
      if (b1 != 0x4D) {
        continue;
      }

      frame[0] = (uint8_t)b0;
      frame[1] = (uint8_t)b1;

      // Read the rest of the frame with timeout.
      unsigned long frameStart = millis();
      int idx = 2;
      while (idx < FRAME_LEN && (millis() - frameStart < 1500)) {
        if (Serial1.available()) {
          frame[idx++] = (uint8_t)Serial1.read();
        }
      }

      if (idx != FRAME_LEN) {
        return false;
      }

      // Validate checksum: sum of first 30 bytes equals last two bytes.
      uint16_t sum = 0;
      for (int i = 0; i < 30; i++) {
        sum += frame[i];
      }
      uint16_t checksum = ((uint16_t)frame[30] << 8) | frame[31];
      if (sum != checksum) {
        return false;
      }

      // Atmospheric environment values
      outPm10 = ((uint16_t)frame[10] << 8) | frame[11];
      outPm25 = ((uint16_t)frame[12] << 8) | frame[13];
      outPm100 = ((uint16_t)frame[14] << 8) | frame[15];
      return true;
    }
  }

  return false;
}

void setLedForPm25(uint16_t currentPm25) {
  if (currentPm25 <= 10) { // green
    digitalWrite(REDled, HIGH);
    digitalWrite(GREENled, LOW);
    digitalWrite(BLUEled, HIGH);
    colour = "green";
  } else if (currentPm25 <= 20) { // cyan
    digitalWrite(REDled, HIGH);
    digitalWrite(GREENled, LOW);
    digitalWrite(BLUEled, LOW);
    colour = "cyan";
  } else if (currentPm25 <= 30) { // blue
    digitalWrite(REDled, HIGH);
    digitalWrite(GREENled, HIGH);
    digitalWrite(BLUEled, LOW);
    colour = "blue";
  } else if (currentPm25 <= 40) { // magenta
    digitalWrite(REDled, LOW);
    digitalWrite(GREENled, HIGH);
    digitalWrite(BLUEled, LOW);
    colour = "magenta";
  } else if (currentPm25 <= 100) { // red
    digitalWrite(REDled, LOW);
    digitalWrite(GREENled, HIGH);
    digitalWrite(BLUEled, HIGH);
    colour = "red";
  } else { // white
    digitalWrite(REDled, LOW);
    digitalWrite(GREENled, LOW);
    digitalWrite(BLUEled, LOW);
    colour = "white";
  }
}

void publishWithThrottle(const char* eventName, const String& value, bool isPrivate = false) {
  if (isPrivate) {
    Particle.publish(eventName, value, PRIVATE);
  } else {
    Particle.publish(eventName, value);
  }
  // Keep within practical publish rate limits while minimizing total blocking delay.
  delay(1100);
}

void setup() {
  Serial.begin(9600);
  Serial1.begin(9600);
  dht.begin();

  pinMode(REDled, OUTPUT);
  pinMode(GREENled, OUTPUT);
  pinMode(BLUEled, OUTPUT);
  pinMode(LEDpower, OUTPUT);
  pinMode(SLEEPLED, OUTPUT);

  analogWrite(LEDpower, brightness); // powers LED strip at configured brightness
}

void loop() {
  delay(2000);

  Serial1.write(wake, sizeof(wake));
  Serial.println("Awake");
  delay(5000); // warm-up time; reduced from 20s to improve responsiveness

  bool frameOk = readPms5003Frame(pm10, pm25, pm100);
  if (frameOk) {
    Serial.print("{ \"pm10\": ");
    Serial.print(pm10);
    Serial.print(", \"pm25\": ");
    Serial.print(pm25);
    Serial.print(", \"pm100\": ");
    Serial.print(pm100);
    Serial.println(" }");
  } else {
    Serial.println("Failed to read valid PMS5003 frame.");
  }

  // Clear any extra serial data before next cycle.
  while (Serial1.available()) {
    Serial1.read();
  }

  temperature = dht.getTempCelcius();
  humidity = dht.getHumidity();
  temperature = (temperature * 1.8) + 32; // Convert C to F

  setLedForPm25(pm25);

  // Publish data
  publishWithThrottle("temperature", String(temperature) + " °F", true);
  publishWithThrottle("humidity", String(humidity) + "%");
  publishWithThrottle("pm25", String(pm25) + " ug/m3");
  publishWithThrottle("pm1", String(pm10) + " ug/m3");
  publishWithThrottle("pm10", String(pm100) + " ug/m3");
  publishWithThrottle("colour", colour);

  if (pm25 > 15 && filter == 0) {
    filter = 1;
    publishWithThrottle("filter", String(filter));
  }

  if (pm25 <= 10 && filter == 1) {
    filter = 0;
    publishWithThrottle("filter", String(filter));
  }

  Serial1.write(sleep, sizeof(sleep));
  Serial.println("Asleep");

  delay(30000); // reduced from 120s for better responsiveness
}
